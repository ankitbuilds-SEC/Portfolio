# Server configuration
PORT=3000

# Required admin authentication; replace both values before starting the server.
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=replace-with-a-unique-password
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret

# Optional: comma-separated exact origins for cross-origin API requests.
CORS_ALLOWED_ORIGINS=

# Optional: Supabase configuration
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: AI chatbot configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: email notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ADMIN_EMAIL=
EMAIL_FROM_NAME=Portfolio Contact Form

# Optional rate limiting
# RATE_LIMIT_WINDOW=60000
# MAX_SUBMISSIONS_PER_WINDOW=5
